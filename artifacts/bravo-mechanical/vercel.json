{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/ac-not-cooling-westchester",
      "destination": "/blog/why-is-my-ac-not-cooling-westchester",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "bravomechanicalny.com" }],
      "destination": "https://www.bravomechanicalny.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/auth", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" },
    { "source": "/proposal/:path*", "destination": "/" },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "app.bravomechanicalny.com" }],
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/auth",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/proposal/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
